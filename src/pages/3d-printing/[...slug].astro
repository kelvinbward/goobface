---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/ui/Navbar.astro";
import SpaceBackground from "../../components/ui/SpaceBackground.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const posts = await getCollection("printing");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} // Goobface 3D`}>
    <div class="relative min-h-screen overflow-hidden bg-[#050510] text-white selection:bg-purple-500 selection:text-black">
        <SpaceBackground />

        <main class="relative z-10 pointer-events-none">
            <Navbar />

            <section class="max-w-4xl mx-auto px-6 pt-8 pb-24 pointer-events-auto">
                <article class="p-6 sm:p-10 rounded-3xl bg-slate-950/90 border border-slate-800 shadow-2xl backdrop-blur-xl">
                    <a 
                        href="/3d-printing" 
                        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-700 transition-colors mb-8"
                    >
                        ← Back to 3D Lab
                    </a>

                    <div class="flex items-center gap-2 mb-4 flex-wrap">
                        {post.data.tags?.map((tag: string) => (
                            <span class="text-xs font-mono uppercase px-2.5 py-1 rounded-md bg-purple-950 text-purple-300 border border-purple-800">
                                {tag}
                            </span>
                        ))}
                    </div>

                    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4">
                        {post.data.title}
                    </h1>

                    <p class="text-slate-400 text-base mb-8 pb-6 border-b border-slate-800">
                        {post.data.description}
                    </p>

                    <div class="prose prose-invert prose-purple max-w-none prose-pre:bg-slate-900 prose-pre:border prose-pre:border-slate-800 text-slate-200">
                        <Content />
                    </div>
                </article>
            </section>

            <footer class="text-center py-12 text-white/20 text-sm font-mono pointer-events-auto">
                2026 // GOOBFACE LABS
            </footer>
        </main>
    </div>
</Layout>
