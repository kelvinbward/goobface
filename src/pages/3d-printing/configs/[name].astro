---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/ui/Navbar.astro";
import SpaceBackground from "../../../components/ui/SpaceBackground.astro";

export async function getStaticPaths() {
    const configModules = import.meta.glob<string>('/src/content/printer_data/*', { query: '?raw', import: 'default', eager: true });
    return Object.entries(configModules).map(([path, content]) => {
        const filename = path.split('/').pop() || '';
        return {
            params: { name: filename },
            props: { name: filename, code: content },
        };
    });
}

const { name, code } = Astro.props;
const lines = (code || "").split("\n");
---

<Layout title={`${name} // Klipper Config Store`}>
    <div class="relative min-h-screen overflow-hidden bg-[#050510] text-white selection:bg-emerald-500 selection:text-black">
        <SpaceBackground />

        <main class="relative z-10 pointer-events-none">
            <Navbar />

            <section class="max-w-6xl mx-auto px-6 pt-8 pb-24 pointer-events-auto">
                <div class="p-6 sm:p-10 rounded-3xl bg-slate-950/90 border border-slate-800 shadow-2xl backdrop-blur-xl">
                    <!-- Top Navigation & Actions -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-6 border-b border-slate-800">
                        <div>
                            <a 
                                href="/3d-printing/configs" 
                                class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-700 transition-colors mb-3"
                            >
                                ← Back to Config Store
                            </a>
                            <h1 class="text-2xl sm:text-3xl font-black text-white font-mono flex items-center gap-3">
                                <span class="text-emerald-400">📄</span> {name}
                            </h1>
                        </div>

                        <div class="flex items-center gap-3">
                            <button
                                id="copy-btn"
                                class="px-4 py-2 rounded-xl text-xs font-bold bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 transition-all flex items-center gap-2"
                            >
                                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                                    <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
                                </svg>
                                <span id="copy-text">COPY CONFIG</span>
                            </button>
                        </div>
                    </div>

                    <!-- Metadata Bar -->
                    <div class="flex items-center gap-4 text-xs font-mono text-slate-400 mb-6 bg-slate-900/60 p-3 rounded-xl border border-slate-800 flex-wrap">
                        <div><span class="text-slate-500">FILE:</span> {name}</div>
                        <div>•</div>
                        <div><span class="text-slate-500">LINES:</span> {lines.length}</div>
                        <div>•</div>
                        <div><span class="text-slate-500">SIZE:</span> {(code.length / 1024).toFixed(2)} KB</div>
                        <div>•</div>
                        <div><span class="text-slate-500">SYNTAX:</span> INI / Klipper G-Code</div>
                    </div>

                    <!-- Code Viewer with Line Numbers -->
                    <div class="rounded-2xl bg-slate-950 border border-slate-800 overflow-x-auto shadow-inner text-sm font-mono leading-relaxed">
                        <div class="min-w-full inline-block py-4">
                            {lines.map((line, idx) => {
                                const isComment = line.trim().startsWith('#');
                                const isSection = line.trim().startsWith('[') && line.trim().endsWith(']');
                                return (
                                    <div class="flex hover:bg-slate-900/70 px-4 py-0.5 transition-colors">
                                        <span class="w-12 text-slate-600 text-right pr-4 select-none shrink-0 border-r border-slate-800/80">
                                            {idx + 1}
                                        </span>
                                        <span class={`pl-4 whitespace-pre ${
                                            isComment 
                                                ? 'text-slate-500 italic' 
                                                : isSection 
                                                    ? 'text-cyan-400 font-bold' 
                                                    : 'text-slate-200'
                                        }`}>
                                            {line}
                                        </span>
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                </div>
            </section>

            <footer class="text-center py-12 text-white/20 text-sm font-mono pointer-events-auto">
                2026 // GOOBFACE LABS
            </footer>
        </main>
    </div>
</Layout>

<script is:inline define:vars={{ code }}>
    document.addEventListener('DOMContentLoaded', () => {
        const copyBtn = document.getElementById('copy-btn');
        const copyText = document.getElementById('copy-text');

        copyBtn?.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(code);
                if (copyText) copyText.textContent = 'COPIED!';
                copyBtn.classList.remove('bg-emerald-500/10', 'text-emerald-400');
                copyBtn.classList.add('bg-emerald-500', 'text-slate-950');

                setTimeout(() => {
                    if (copyText) copyText.textContent = 'COPY CONFIG';
                    copyBtn.classList.remove('bg-emerald-500', 'text-slate-950');
                    copyBtn.classList.add('bg-emerald-500/10', 'text-emerald-400');
                }, 2000);
            } catch (err) {
                console.error('Failed to copy code: ', err);
            }
        });
    });
</script>
