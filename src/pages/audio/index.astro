---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/ui/Navbar.astro";
import SpaceBackground from "../../components/ui/SpaceBackground.astro";
import AudioLabApp from "../../apps/audio-lab/AudioLabApp.astro";
---

<Layout title="Creative Audio Lab // Goobface">
    <div class="relative min-h-screen overflow-hidden bg-[#050510] text-white selection:bg-cyan-500 selection:text-black">
        <SpaceBackground />

        <main class="relative z-10 pointer-events-none">
            <Navbar />

            <section class="max-w-6xl mx-auto px-6 pt-8 pb-24 pointer-events-auto">
                <AudioLabApp />
            </section>

            <footer class="text-center py-12 text-white/20 text-sm font-mono pointer-events-auto">
                2026 // GOOBFACE LABS // CREATIVE AUDIO
            </footer>
        </main>
    </div>
</Layout>
