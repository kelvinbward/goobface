---
---

<div class="audio-processor-card w-full max-w-xl mx-auto p-6 rounded-2xl bg-slate-900/90 border border-cyan-500/30 shadow-2xl shadow-cyan-950/50 backdrop-blur-md text-slate-100">
    <div class="flex items-center justify-between mb-6 border-b border-slate-800 pb-4">
        <div class="flex items-center gap-3">
            <div class="w-3 h-3 rounded-full bg-cyan-400 animate-pulse"></div>
            <h2 class="text-xl font-bold tracking-wider bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 via-teal-300 to-blue-500">
                TONE.JS AUDIO PROCESSOR
            </h2>
        </div>
        <span class="text-xs px-2.5 py-1 rounded-full bg-cyan-950 text-cyan-400 border border-cyan-800 font-mono">
            CREATIVE AUDIO LAB
        </span>
    </div>

    <div class="space-y-6">
        <!-- Distortion Control -->
        <div class="p-4 rounded-xl bg-slate-950/70 border border-slate-800 hover:border-cyan-500/40 transition-colors">
            <div class="flex justify-between items-center mb-2">
                <label for="distortion-dist" class="text-sm font-semibold text-cyan-300">Distortion (Grit)</label>
                <span id="dist-val" class="text-xs font-mono text-cyan-400">0.00</span>
            </div>
            <input 
                type="range" 
                id="distortion-dist" 
                min="0" 
                max="1" 
                step="0.01" 
                value="0"
                class="w-full accent-cyan-400 h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer"
            >
        </div>

        <!-- Delay Control -->
        <div class="p-4 rounded-xl bg-slate-950/70 border border-slate-800 hover:border-cyan-500/40 transition-colors">
            <div class="flex justify-between items-center mb-2">
                <label for="delay-wet" class="text-sm font-semibold text-cyan-300">Feedback Delay (Echo)</label>
                <span id="delay-val" class="text-xs font-mono text-cyan-400">0.00</span>
            </div>
            <input 
                type="range" 
                id="delay-wet" 
                min="0" 
                max="1" 
                step="0.01" 
                value="0"
                class="w-full accent-cyan-400 h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer"
            >
        </div>

        <!-- Waveform Visualizer Canvas -->
        <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 flex flex-col items-center">
            <div class="w-full flex justify-between text-xs text-slate-400 mb-2 font-mono">
                <span>REALTIME WAVEFORM SPECTRUM</span>
                <span id="status-indicator" class="text-amber-400">PAUSED</span>
            </div>
            <canvas id="audio-canvas" class="w-full h-28 rounded bg-slate-950 border border-slate-900"></canvas>
        </div>

        <!-- Play/Stop Button -->
        <div class="pt-2 flex justify-center">
            <button 
                id="start-stop" 
                class="w-full py-3.5 px-6 rounded-xl font-bold tracking-wider text-sm transition-all duration-300 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 shadow-lg shadow-cyan-500/25 active:scale-95 flex items-center justify-center gap-2"
            >
                <svg id="play-icon" class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                </svg>
                <span id="btn-text">START AUDIO SYNTH</span>
            </button>
        </div>
    </div>
</div>

<script>
    import { AudioProcessorEngine } from '../../lib/audio/processor';

    let engine: AudioProcessorEngine | null = null;
    let animFrameId: number | null = null;

    document.addEventListener('DOMContentLoaded', () => {
        const startBtn = document.getElementById('start-stop') as HTMLButtonElement;
        const btnText = document.getElementById('btn-text') as HTMLSpanElement;
        const distInput = document.getElementById('distortion-dist') as HTMLInputElement;
        const delayInput = document.getElementById('delay-wet') as HTMLInputElement;
        const distVal = document.getElementById('dist-val') as HTMLSpanElement;
        const delayVal = document.getElementById('delay-val') as HTMLSpanElement;
        const statusIndicator = document.getElementById('status-indicator') as HTMLSpanElement;
        const canvas = document.getElementById('audio-canvas') as HTMLCanvasElement;
        const ctx = canvas?.getContext('2d');

        function resizeCanvas() {
            if (canvas && ctx) {
                canvas.width = canvas.clientWidth * window.devicePixelRatio;
                canvas.height = canvas.clientHeight * window.devicePixelRatio;
            }
        }

        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        // Draw background grid lines
        function drawGrid() {
            if (!ctx || !canvas) return;
            ctx.strokeStyle = '#0f172a';
            ctx.lineWidth = 1;

            // Horizontal center line
            ctx.beginPath();
            ctx.moveTo(0, canvas.height / 2);
            ctx.lineTo(canvas.width, canvas.height / 2);
            ctx.stroke();

            // Vertical grid lines
            const gridSpacing = canvas.width / 8;
            for (let x = gridSpacing; x < canvas.width; x += gridSpacing) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, canvas.height);
                ctx.stroke();
            }
        }

        // Draw idle wave line
        function drawIdleWave() {
            if (!ctx || !canvas) return;
            ctx.fillStyle = '#020617';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            drawGrid();

            ctx.beginPath();
            ctx.strokeStyle = '#0e7490';
            ctx.lineWidth = 2;
            const midY = canvas.height / 2;
            ctx.moveTo(0, midY);
            ctx.lineTo(canvas.width, midY);
            ctx.stroke();
        }

        drawIdleWave();

        // Real-time animation loop
        function drawWaveform() {
            if (!ctx || !canvas || !engine) return;

            const values = engine.getWaveformData();
            ctx.fillStyle = '#020617';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            drawGrid();

            // Draw glowing gradient background under waveform
            const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
            gradient.addColorStop(0, 'rgba(6, 182, 212, 0.25)');
            gradient.addColorStop(0.5, 'rgba(14, 116, 144, 0.05)');
            gradient.addColorStop(1, 'rgba(59, 130, 246, 0.25)');

            ctx.beginPath();
            const sliceWidth = canvas.width / values.length;
            let x = 0;

            for (let i = 0; i < values.length; i++) {
                const v = values[i];
                const y = ((v + 1) / 2) * canvas.height;

                if (i === 0) {
                    ctx.moveTo(x, y);
                } else {
                    ctx.lineTo(x, y);
                }
                x += sliceWidth;
            }

            ctx.strokeStyle = '#22d3ee';
            ctx.lineWidth = 3.5;
            ctx.shadowColor = '#06b6d4';
            ctx.shadowBlur = 12;
            ctx.stroke();

            // Reset shadow for next frame
            ctx.shadowBlur = 0;

            if (engine.isPlaying()) {
                animFrameId = requestAnimationFrame(drawWaveform);
            }
        }

        // Initialize engine on demand
        function getEngine() {
            if (!engine) {
                engine = new AudioProcessorEngine();
            }
            return engine;
        }

        distInput?.addEventListener('input', (e) => {
            const val = parseFloat((e.target as HTMLInputElement).value);
            if (distVal) distVal.textContent = val.toFixed(2);
            getEngine().setDistortion(val);
        });

        delayInput?.addEventListener('input', (e) => {
            const val = parseFloat((e.target as HTMLInputElement).value);
            if (delayVal) delayVal.textContent = val.toFixed(2);
            getEngine().setDelay(val);
        });

        startBtn?.addEventListener('click', async () => {
            const eng = getEngine();
            const isPlaying = await eng.toggleAudio();

            if (isPlaying) {
                if (btnText) btnText.textContent = 'STOP AUDIO SYNTH';
                if (statusIndicator) {
                    statusIndicator.textContent = 'LIVE OSCILLOSCOPE';
                    statusIndicator.className = 'text-cyan-400 font-bold animate-pulse';
                }
                startBtn.classList.remove('from-cyan-500', 'to-blue-600');
                startBtn.classList.add('from-rose-500', 'to-pink-600');

                if (animFrameId) cancelAnimationFrame(animFrameId);
                drawWaveform();
            } else {
                if (btnText) btnText.textContent = 'START AUDIO SYNTH';
                if (statusIndicator) {
                    statusIndicator.textContent = 'PAUSED';
                    statusIndicator.className = 'text-amber-400';
                }
                startBtn.classList.remove('from-rose-500', 'to-pink-600');
                startBtn.classList.add('from-cyan-500', 'to-blue-600');

                if (animFrameId) {
                    cancelAnimationFrame(animFrameId);
                    animFrameId = null;
                }
                drawIdleWave();
            }
        });
    });
</script>
